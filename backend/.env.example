APP_NAME="MBALA KWA SELEMANI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Local (SQLite) ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

